---
import { SITE, getProducts, productPath, url } from '../lib/site';

const products = await getProducts();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <section>
      <h3>{SITE.name}</h3>
      <p>{SITE.footerDescription}</p>
      <h3>お問い合わせ</h3>
      <p>{SITE.location}</p>
      <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </section>
    <section>
      <h3>ボードゲーム作品</h3>
      <div class="image-grid">
        {
          products.map((p) => (
            <a href={url(productPath(p.data.permalink))} title={p.data.title}>
              <img src={url(p.data.thumbnail)} alt={p.data.title} width="80" height="50" loading="lazy" />
            </a>
          ))
        }
      </div>
    </section>
    <section>
      <h3>Twitter</h3>
      <p><a href={SITE.twitter} target="_blank" rel="noopener">{SITE.twitterHandle} さんのツイート</a></p>
    </section>
  </div>
  <p class="credits">&copy; {year} {SITE.name}</p>
</footer>
